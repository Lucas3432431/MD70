# ==================== APP VERSION ====================
APP_VERSION=v1.0

# ==================== ENVIRONMENT ====================
ENV=development
HOT_RELOAD_ENABLED=true
DEBUG=True
SO=linux
HOST=0.0.0.0

# ==================== BACKEND ====================
BACKEND_HOST=0.0.0.0
GATEWAY_BACKEND_HOST=backend
BACKEND_PORT=4101
PORT=4101
HOT_RELOAD=true
HTTPS_PUBLIC_URL_METHOD=cloudflare
HEALTH_ANSWER=8181
SANDBOX_URL=http://localhost:8101
BROWSER_SERVICE_URL=http://localhost:8102

# ==================== FRONTEND ====================
FRONTEND_HOST=0.0.0.0
GATEWAY_FRONTEND_HOST=frontend
VITE_HOST=0.0.0.0
FRONTEND_PORT=5182
GATEWAY_WEB_HOST=frontend
GATEWAY_WEB_PORT=5082

# ==================== GATEWAY ====================
NGINX_PORT=8181
GATEWAY_HTTP_PORT=8181
GATEWAY_HTTPS_PORT=8543
DOMAIN_NAME=app.localhost
INSTITUTIONAL_DOMAIN_NAME=localhost
CARDAPIO_DOMAIN_NAME=cardapio.localhost
DELIVERY_DOMAIN_NAME=delivery.localhost
ENVIRONMENT=development
DNS_RESOLVER=8.8.8.8

# ==================== REDIS ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6481
REDIS_INTERNAL_PORT=6379
REDIS_PASSWORD=change_me
WSL_REDIS_URL=

# ==================== FRONTEND VITE ====================
VITE_HTTP_PROTOCOL=http
VITE_DOMAIN=app.localhost:8181
PUBLIC_URL=https://your-tunnel.trycloudflare.com

VITE_DEV_ONLY_FEATURES=false

# ==================== LOGGING ====================
LOG_LEVEL=debug
SESSION_ID=true
LOG_ID=true
LOG_TIMESTAMP=true
LOG_RESPONSIBLE_FILE=true
LOG_SILENCE=false
EXTERNAL_LOGGING=false
SENSITIVE_FILTER=true
DEVOPS_HOST=http://localhost:3002
DEVOPS_SERVICE_ID=1
LOG_STORAGE=database
LOG_FORMAT=text
SECURITY_FILTER=true

# ==================== DATABASE ====================
# Categorias: local | cloud-rest | cloud-tcp
DB_ENV=local
MOCK=off
MOCK_ADMIN_EMAIL=admin@md70.com.br
MOCK_ADMIN_PASSWORD=change_me
# Secret TOTP base32 do admin mock — gere com: python3 -c "import pyotp; print(pyotp.random_base32())"
MOCK_ADMIN_TOTP_SECRET=BASE32SECRETHERE
MOCK_INVESTOR_EMAIL=investidor@md70.com.br
MOCK_INVESTOR_PASSWORD=change_me
RESET_LOCAL_DB=false
RATE_LIMITING_ON=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_DB_PASSWORD=
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_STORAGE_BUCKET=MD70

# ==================== LITESTREAM (SQLite → Supabase S3) ====================
LITESTREAM_ENABLED=false
LITESTREAM_DB_PATH=md70_dev
LITESTREAM_ANALYTICS_DB_PATH=md70_analytics_dev
LITESTREAM_BUCKET=md70-db
LITESTREAM_S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
LITESTREAM_ACCESS_KEY_ID=your_access_key_id
LITESTREAM_SECRET_ACCESS_KEY=your_secret_access_key

# ==================== LLM API KEYS ====================
OPENAI_API_KEY=sk-proj-...
DEEPSEEK_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-api03-...
GOOGLE_API_KEY=AIza...
GOOGLE_MAPS_API_KEY=AIza...

# ==================== STRIPE & PAYMENTS ====================
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ==================== VALIDATION API ====================
ABSTRACT_PHONE_API_KEY=your_abstract_phone_key
ABSTRACT_EMAIL_API_KEY=your_abstract_email_key

# ==================== GOOGLE & OAUTH ====================
GOOGLE_AUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_SECRET=GOCSPX-...
GOOGLE_AUTH_CALLBACK_URLS=http://localhost:5082/auth/callback

# Google Ads API
GADS_DEVELOPER_TOKEN=your_token
GADS_CUSTOMER_ID=0000000000

# ==================== DEV BYPASS ====================
DEV_BYPASS_KEY=dev-secret-key-change-me
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_CLIENT_ID=00000000-0000-0000-0000-000000000002
EMAIL_BYPASS=test@example.com
PHONE_BYPASS=+5511999999999

# ==================== SECURITY ====================
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_64_char_hex_secret_here
VITE_2FA=true

# ==================== USER LIMITS ====================
MAX_USERS=10
MAX_CONSECUTIVE_TOOL_ERRORS=10
SIGNUP_BONUS=0
MAX_ITERATIONS=25

# ==================== AI/LLM ====================
AI=deepseek

# ==================== ADMIN ====================
ADMIN_EMAIL=admin@your-domain.com
2FA=true
ADMIN_TOTP_SECRET=BASE32SECRETHERE

# ==================== PRICING ====================
CREDIT_VALUE_COST=60
OUTPUT_TOKEN_COST=1630
TOKEN_INPUT_COST=978
TOKEN_OUTPUT_COST=1630
GEN_IMG_COST=133
GEN_FILM_COST=1630
WEB_SEARCH_COST=50

# ==================== CONTAINER ====================
CLEAR_TERMINAL=true
IS_CONTAINERED=false
VALIDATE_DEPS=false

# ==================== GOOGLE CLOUD CREDENTIALS ====================
GOOGLE_CREDENTIALS_TYPE=service_account
GOOGLE_CREDENTIALS_PROJECT_ID=your-project-id
GOOGLE_CREDENTIALS_PRIVATE_KEY_ID=your_key_id
GOOGLE_CREDENTIALS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CREDENTIALS_CLIENT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
GOOGLE_CREDENTIALS_CLIENT_ID=000000000000000000000
GOOGLE_CREDENTIALS_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_CREDENTIALS_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_CREDENTIALS_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CREDENTIALS_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your-sa%40your-project.iam.gserviceaccount.com
GOOGLE_CREDENTIALS_UNIVERSE_DOMAIN=googleapis.com
GOOGLE_CLOUD_LOCATION=us-central1

# ==================== RESEND EMAIL ====================
RESEND_API_KEY=re_...

# ==================== TELEGRAM ====================
TELEGRAM_BOT_TOKEN=0000000000:AAH...
TELEGRAM_CHAT_ID=0000000000

# ==================== OMNI-CHANNEL ====================
OMNI_VERIFY_TOKEN=your_verify_token
OMNI_TELEGRAM_BOT_TOKEN=0000000000:AAF...
OMNI_TELEGRAM_BOT_USERNAME=your_bot
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
OMNI_EMAIL_FROM=noreply@your-domain.com

# ==================== HMR ====================
HMR_HOST=localhost
HMR_PORT=8181
HMR_CLIENT_PORT=8181

# ==================== WEBHOOK ====================
STRIPE_WEBHOOK_URL=https://your-tunnel.trycloudflare.com

# ModSecurity Tuning
ANOMALY_INBOUND=100
ANOMALY_OUTBOUND=100
MODSEC_RULE_EXCLUSIONS=920350 920280 920300 920420 920320

# ==================== META ADS ====================
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
SANDBOX_EXPOSE_PORT=127.0.0.1:8101:8001
BROWSER_EXPOSE_PORT=127.0.0.1:8102:8002

