# Bot / crawler detection — routes to backend OG endpoint on links subdomain
map $http_user_agent $is_bot {
    default                         0;
    ~*facebookexternalhit           1;
    ~*Facebot                       1;
    ~*Twitterbot                    1;
    ~*TelegramBot                   1;
    ~*WhatsApp                      1;
    ~*LinkedInBot                   1;
    ~*Googlebot                     1;
    ~*Slackbot                      1;
    ~*Discordbot                    1;
    ~*Pinterest                     1;
    ~*bingbot                       1;
    ~*Applebot                      1;
    ~*rogerbot                      1;
    ~*ia_archiver                   1;
    ~*Embedly                       1;
    ~*vkShare                       1;
    ~*W3C_Validator                 1;
    ~*Iframely                      1;
    ~*Semrushbot                    1;
    ~*AhrefsBot                     1;
    ~*DuckDuckBot                   1;
}

# Rate Limit Zones
map $request_method $limit_key {
    GET     "";
    HEAD    "";
    default $binary_remote_addr;
}

# Suporte para WebSockets e Keep-Alive
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      "";
}

# Origens internas permitidas (app Prox)
map $http_origin $origin_allowed {
    default                                        0;
    ""                                             1;
    ~*^https?://localhost(:[0-9]+)?$               1;
    ~*^https?://${DOMAIN_NAME}(:[0-9]+)?$          1;
    ~*^https?://${CARDAPIO_DOMAIN_NAME}(:[0-9]+)?$ 1;
    ~*^https?://${DELIVERY_DOMAIN_NAME}(:[0-9]+)?$ 1;
    ~^${PUBLIC_URL}$                               1;
    ~*^chrome-extension://                         1;
}

# CORS para /api/* — só reflete a origin se for interna.
# Origins externas recebem header vazio → browser bloqueia o request.
# Webhooks e SDK usam políticas próprias mais abertas.
map $http_origin $api_cors_origin {
    default                                        "";
    ""                                             "";
    ~*^https?://localhost(:[0-9]+)?$               $http_origin;
    ~*^https?://${DOMAIN_NAME}(:[0-9]+)?$          $http_origin;
    ~*^https?://${CARDAPIO_DOMAIN_NAME}(:[0-9]+)?$ $http_origin;
    ~*^https?://${DELIVERY_DOMAIN_NAME}(:[0-9]+)?$ $http_origin;
    ~^${PUBLIC_URL}$                               $http_origin;
    ~*^chrome-extension://                         $http_origin;
}

limit_req_zone $limit_key zone=api_write:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api_read:10m rate=2000r/m;
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=upload:10m rate=4r/m;
limit_req_zone $binary_remote_addr zone=webhook:10m rate=120r/m;
limit_req_zone $binary_remote_addr zone=health:10m  rate=30r/m;

limit_conn_zone $binary_remote_addr zone=ws_conn:10m;

limit_req_status 429;
limit_req_log_level warn;

server {
    listen 0.0.0.0:${NGINX_PORT};
    server_name ${DOMAIN_NAME};

    set $web_upstream ${WEB_HOST}:${WEB_PORT};
    set $backend_upstream ${BACKEND_HOST}:${BACKEND_PORT};
    set $analytics_upstream ${ANALYTICS_HOST}:${ANALYTICS_PORT};

    server_tokens off;
    more_clear_headers Server;
    more_clear_headers X-Powered-By;

    modsecurity on;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    chunked_transfer_encoding off;

    keepalive_timeout 65;
    keepalive_requests 100;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://www.googletagmanager.com https://*.clarity.ms https://cdn.tailwindcss.com https://cdn.jsdelivr.net https://unpkg.com https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.tailwindcss.com https://cdn.jsdelivr.net https://unpkg.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' wss: https://${DOMAIN_NAME} ${PUBLIC_URL} https://accounts.google.com https://oauth2.googleapis.com https://www.google-analytics.com https://region1.google-analytics.com https://*.clarity.ms https://api.stripe.com https://r.stripe.com https://m.stripe.com https://*.stripe.network; font-src 'self' data: https://fonts.gstatic.com; frame-src 'self' https://accounts.google.com https://www.googletagmanager.com https://js.stripe.com https://hooks.stripe.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self';" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=()" always;
    add_header X-Permitted-Cross-Domain-Policies "none" always;

    set $cors_methods "GET, POST, PUT, DELETE, PATCH, HEAD, OPTIONS";
    set $cors_headers "Content-Type, Authorization, X-Requested-With, X-CSRF-Token, X-Dev-Bypass-Key, X-Fingerprint-ID, ngrok-skip-browser-warning, Accept";

    location /nginx-health {
        limit_req zone=health burst=5 nodelay;
        access_log off;
        add_header Set-Cookie "sec_test=1; HttpOnly; Secure; SameSite=Strict";
        return 200 "healthy\n";
    }

    location = /api/health {
        limit_req zone=health burst=5 nodelay;
        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        access_log off;
    }

    location ^~ /api/auth {
        limit_req zone=auth burst=10 nodelay;

        # CSRF: bloqueia mutações de origens não permitidas
        set $csrf_block "";
        if ($request_method ~* "^(POST|PUT|PATCH|DELETE)$") { set $csrf_block "1"; }
        if ($origin_allowed)                                  { set $csrf_block "";  }
        if ($csrf_block = "1")                                { return 403 "CSRF blocked"; }

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin      $api_cors_origin always;
            add_header Access-Control-Allow-Methods     $cors_methods always;
            add_header Access-Control-Allow-Headers     $cors_headers always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Max-Age           86400 always;
            return 204;
        }

        add_header Access-Control-Allow-Origin      $api_cors_origin always;
        add_header Access-Control-Allow-Credentials true always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;

        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_hide_header Server;
    }

    location ~ ^/api/chat/(.*)/message {
        limit_req zone=api_write burst=30 nodelay;

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin      $api_cors_origin always;
            add_header Access-Control-Allow-Methods     $cors_methods always;
            add_header Access-Control-Allow-Headers     $cors_headers always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Max-Age           86400 always;
            return 204;
        }

        add_header Access-Control-Allow-Origin      $api_cors_origin always;
        add_header Access-Control-Allow-Credentials true always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;

        modsecurity_rules 'SecRuleEngine Off';

        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location ^~ /api/proxy/ {
        modsecurity off;

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin      $api_cors_origin always;
            add_header Access-Control-Allow-Methods     "GET, HEAD, OPTIONS" always;
            add_header Access-Control-Allow-Headers     $cors_headers always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Max-Age           86400 always;
            return 204;
        }

        add_header Access-Control-Allow-Origin      $api_cors_origin always;
        add_header Access-Control-Allow-Methods     "GET, HEAD, OPTIONS" always;
        add_header Access-Control-Allow-Headers     $cors_headers always;
        add_header Access-Control-Allow-Credentials true always;
        add_header Cache-Control "public, max-age=3600" always;
        add_header Vary Origin always;

        limit_req zone=api_read burst=500 nodelay;

        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
    }

    location ~ ^/api/chat/[^/]+/creative {
        modsecurity_rules 'SecRuleEngine Off';
        client_max_body_size 20m;

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin      $api_cors_origin always;
            add_header Access-Control-Allow-Methods     $cors_methods always;
            add_header Access-Control-Allow-Headers     $cors_headers always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Max-Age           86400 always;
            return 204;
        }

        add_header Access-Control-Allow-Origin      $api_cors_origin always;
        add_header Access-Control-Allow-Credentials true always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;

        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_connect_timeout 90s;
        proxy_send_timeout 90s;
        proxy_read_timeout 90s;
    }

    location ~ ^/api/chat/[^/]+/upload-audio$ {
        modsecurity_rules 'SecRuleEngine Off';
        client_max_body_size 20m;
        limit_req zone=upload burst=5 nodelay;

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin      $api_cors_origin always;
            add_header Access-Control-Allow-Methods     $cors_methods always;
            add_header Access-Control-Allow-Headers     $cors_headers always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Max-Age           86400 always;
            return 204;
        }

        add_header Access-Control-Allow-Origin      $api_cors_origin always;
        add_header Access-Control-Allow-Credentials true always;

        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location ~ ^/api/audio/ {
        modsecurity_rules 'SecRuleEngine Off';
        client_max_body_size 20m;
        limit_req zone=upload burst=5 nodelay;

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin      $api_cors_origin always;
            add_header Access-Control-Allow-Methods     $cors_methods always;
            add_header Access-Control-Allow-Headers     $cors_headers always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Max-Age           86400 always;
            return 204;
        }

        add_header Access-Control-Allow-Origin      $api_cors_origin always;
        add_header Access-Control-Allow-Credentials true always;

        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location = /api/validate-email {
        limit_req zone=auth burst=5 nodelay;

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin      $api_cors_origin always;
            add_header Access-Control-Allow-Methods     $cors_methods always;
            add_header Access-Control-Allow-Headers     $cors_headers always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Max-Age           86400 always;
            return 204;
        }

        add_header Access-Control-Allow-Origin      $api_cors_origin always;
        add_header Access-Control-Allow-Credentials true always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;

        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
    }

    location ^~ /api/upload {
        client_max_body_size 4m;
        limit_req zone=upload burst=5 nodelay;

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin      $api_cors_origin always;
            add_header Access-Control-Allow-Methods     $cors_methods always;
            add_header Access-Control-Allow-Headers     $cors_headers always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Max-Age           86400 always;
            return 204;
        }

        add_header Access-Control-Allow-Origin      $api_cors_origin always;
        add_header Access-Control-Allow-Credentials true always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;

        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # ── Protótipo — sessão anônima por cookie device_id ──────────────────────
    # Endpoint público (sem auth). ModSecurity desligado: CRS puntua JSON
    # bodies acima do threshold de produção (ANOMALY_INBOUND=10).

    location ^~ /api/prototype/ {
        modsecurity_rules 'SecRuleEngine Off';
        limit_req zone=auth burst=10 nodelay;

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin      $api_cors_origin always;
            add_header Access-Control-Allow-Methods     $cors_methods always;
            add_header Access-Control-Allow-Headers     $cors_headers always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Max-Age           86400 always;
            return 204;
        }

        add_header Access-Control-Allow-Origin      $api_cors_origin always;
        add_header Access-Control-Allow-Credentials true always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;

        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
    }

    # ── Webhooks externos → backend ───────────────────────────────────────────
    # Provedores externos (Meta, Stripe, n8n, Telegram…) chamam estas rotas
    # diretamente de servidores — sem Origin de browser, sem cookies, sem CSRF.
    # ModSecurity off: payloads JSON de terceiros geram falsos positivos.

    location ^~ /webhook/trigger/ {
        limit_req zone=webhook burst=30 nodelay;
        modsecurity_rules 'SecRuleEngine Off';
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "no-store" always;
        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location ^~ /webhook/omnichannel/ {
        limit_req zone=webhook burst=30 nodelay;
        modsecurity_rules 'SecRuleEngine Off';
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "no-store" always;
        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location ^~ /webhook/ {
        limit_req zone=webhook burst=30 nodelay;
        modsecurity_rules 'SecRuleEngine Off';
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "no-store" always;
        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location ^~ /api/ws/ {
        modsecurity off;
        limit_conn ws_conn 30;

        set $ws_csrf_block "";
        if ($origin_allowed = 0) { set $ws_csrf_block "1"; }
        if ($ws_csrf_block = "1") { return 403 "WS CSRF blocked"; }

        proxy_pass http://$backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400s;
    }

    # ── SDK Analytics ─────────────────────────────────────────────────────────
    # CORS aberto com credentials: SDK é embarcado em sites de clientes (qualquer
    # origin). Autenticação feita por sdk_key no payload, não por origin.

    location = /sdk.js {
        modsecurity_rules 'SecRuleEngine Off';
        add_header Access-Control-Allow-Origin      $http_origin always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Vary                             "Origin" always;
        add_header Cache-Control "public, max-age=300" always;
        proxy_pass http://$analytics_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_buffering off;
    }

    location = /sdk/health {
        modsecurity_rules 'SecRuleEngine Off';
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "no-store" always;
        proxy_pass http://$analytics_upstream/sdk/health;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_buffering off;
    }

    location ^~ /track/ {
        modsecurity_rules 'SecRuleEngine Off';
        limit_req zone=webhook burst=200 nodelay;
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin      $http_origin always;
            add_header Access-Control-Allow-Credentials "true" always;
            add_header Access-Control-Allow-Methods "POST, GET, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type" always;
            add_header Access-Control-Max-Age 86400 always;
            add_header Vary "Origin" always;
            return 204;
        }
        add_header Access-Control-Allow-Origin      $http_origin always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Vary                             "Origin" always;
        add_header Cache-Control "no-store" always;
        proxy_pass http://$analytics_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location ^~ /api/portal-admin/ {
        limit_req zone=api_read burst=200 nodelay;
        limit_req zone=api_write burst=30 nodelay;

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin      $api_cors_origin always;
            add_header Access-Control-Allow-Methods     $cors_methods always;
            add_header Access-Control-Allow-Headers     $cors_headers always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Max-Age           86400 always;
            return 204;
        }

        add_header Access-Control-Allow-Origin      $api_cors_origin always;
        add_header Access-Control-Allow-Credentials true always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;

        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location ^~ /api/admin/ {
        allow 177.94.90.93;
        deny all;

        if ($http_x_admin_token = "") {
            return 403;
        }

        limit_req zone=api_write burst=5 nodelay;

        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location /api {
        limit_req zone=api_read burst=200 nodelay;
        limit_req zone=api_write burst=30 nodelay;

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin      $api_cors_origin always;
            add_header Access-Control-Allow-Methods     $cors_methods always;
            add_header Access-Control-Allow-Headers     $cors_headers always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Max-Age           86400 always;
            return 204;
        }

        add_header Access-Control-Allow-Origin      $api_cors_origin always;
        add_header Access-Control-Allow-Credentials true always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;

        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 90s;
        proxy_send_timeout 90s;
        proxy_read_timeout 90s;
    }

    location /ws {
        modsecurity off;
        limit_conn ws_conn 30;

        set $ws_csrf_block "";
        if ($origin_allowed = 0) { set $ws_csrf_block "1"; }
        if ($ws_csrf_block = "1") { return 403 "WS CSRF blocked"; }

        proxy_pass http://$backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400;
    }

    location / {
        proxy_pass http://$web_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400s;
    }
}

# ── Cardápio público ──────────────────────────────────────────────────────────
server {
    listen 0.0.0.0:${NGINX_PORT};
    server_name ${CARDAPIO_DOMAIN_NAME};

    set $web_upstream ${WEB_HOST}:${WEB_PORT};
    set $backend_upstream ${BACKEND_HOST}:${BACKEND_PORT};

    server_tokens off;
    more_clear_headers Server;

    modsecurity on;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
